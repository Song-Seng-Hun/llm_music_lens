# The web app keeps its own ignore rules in web/.gitignore.

.DS_Store
*.pem
.env*
!.env.example
__pycache__/
*.pyc

# Checkout-local tool state; never publish it.
/.agents/
/.codex/
/.cache/
/outputs/
/work/

# Local research inputs/results are preserved here, not redistributed in Git.
/evidence/
/examples/

# AI work log, kept local
/TASKS.md
